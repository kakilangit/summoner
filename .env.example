# Summoner Environment Variables
# Copy this file to .env and fill in your values.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up -d

# ============================================================
# REQUIRED — App will not start without these
# ============================================================

# Initial admin account credentials (used on first boot only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# Phoenix secret key base (generate with: mix phx.gen.secret)
SECRET_KEY_BASE=

# Cloak encryption key for secrets/API keys (generate with: 32 |> :crypto.strong_rand_bytes() |> Base.encode64())
CLOAK_KEY=

# PostgreSQL credentials
POSTGRES_USER=summoner
POSTGRES_PASSWORD=
POSTGRES_DB=summoner

# ============================================================
# OPTIONAL — Defaults shown
# ============================================================

# Public hostname (used for URL generation)
PHX_HOST=localhost

# HTTP port
PORT=4000

# ============================================================
# SMTP — Required for email features (confirmation, password reset)
# Leave blank to disable email delivery.
# ============================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_SSL=false
