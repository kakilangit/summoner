<!DOCTYPE html>
<% user_theme = if @current_scope, do: @current_scope.user.theme, else: "elixir-dark" %>
<html lang="en" data-theme={user_theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Summoner" suffix=" · Summoner">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="stylesheet" href={~p"/assets/themes.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="flex flex-col h-dvh overflow-hidden">
    <nav class="flex-shrink-0 border-b border-base-300">
      <div class="mx-auto max-w-7xl flex items-center justify-between h-14 px-4 sm:px-6 lg:px-8">
        <a href="/" class="text-lg font-bold tracking-tight">Summoner</a>

        <%!-- Desktop nav --%>
        <div class="hidden sm:flex items-center gap-1">
          <%= if @current_scope do %>
            <.link href={~p"/guilds"} class="btn btn-ghost btn-sm">Guilds</.link>
            <%= if @current_scope.user.role == "admin" do %>
              <.link href="/archon" class="btn btn-ghost btn-sm">Archon</.link>
            <% end %>

            <%!-- Settings dropdown --%>
            <div class="dropdown dropdown-end">
              <label tabindex="0" class="btn btn-ghost btn-sm gap-1">
                <span class="hero-cog-6-tooth-micro size-4"></span>
                <span class="hero-chevron-down-micro size-3 opacity-60"></span>
              </label>
              <ul
                tabindex="0"
                class="dropdown-content menu bg-base-200 rounded-box z-50 w-48 p-2 shadow-lg mt-2"
              >
                <li>
                  <.link href={~p"/users/settings"}>
                    <span class="hero-user-micro size-4"></span> Account
                  </.link>
                </li>
                <li>
                  <.link href={~p"/themes"}>
                    <span class="hero-swatch-micro size-4"></span> Themes
                  </.link>
                </li>
                <li class="border-t border-base-300 mt-1 pt-1">
                  <span class="text-xs text-base-content/50 px-2 py-1">
                    {@current_scope.user.email}
                  </span>
                </li>
                <li>
                  <form method="post" action={~p"/users/log-out"}>
                    <input type="hidden" name="_method" value="delete" />
                    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                    <button type="submit" class="w-full text-left flex items-center gap-2">
                      <span class="hero-arrow-right-start-on-rectangle-micro size-4"></span>
                      Log out
                    </button>
                  </form>
                </li>
              </ul>
            </div>
          <% else %>
            <.link href={~p"/users/log-in"} class="btn btn-ghost btn-sm">Log in</.link>
          <% end %>
        </div>

        <%!-- Mobile menu --%>
        <div class="sm:hidden dropdown dropdown-end">
          <label tabindex="0" class="btn btn-ghost btn-sm btn-square">
            <span class="hero-bars-3 size-5"></span>
          </label>
          <ul
            tabindex="0"
            class="dropdown-content menu bg-base-200 rounded-box z-50 w-56 p-2 shadow-lg mt-2"
          >
            <%= if @current_scope do %>
              <li>
                <.link href={~p"/guilds"}>Guilds</.link>
              </li>
              <%= if @current_scope.user.role == "admin" do %>
                <li>
                  <.link href="/archon">Archon</.link>
                </li>
              <% end %>
              <li class="menu-title mt-2">Settings</li>
              <li>
                <.link href={~p"/users/settings"}>Account</.link>
              </li>
              <li>
                <.link href={~p"/themes"}>Themes</.link>
              </li>
              <li class="border-t border-base-300 mt-2 pt-1">
                <span class="text-xs text-base-content/50">{@current_scope.user.email}</span>
              </li>
              <li>
                <form method="post" action={~p"/users/log-out"}>
                  <input type="hidden" name="_method" value="delete" />
                  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                  <button type="submit" class="w-full text-left">Log out</button>
                </form>
              </li>
            <% else %>
              <li><.link href={~p"/users/log-in"}>Log in</.link></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
    <div class="flex-1 min-h-0 flex flex-col">
      {@inner_content}
    </div>
    <footer class="flex-shrink-0 border-t border-base-300">
      <div class="mx-auto max-w-7xl flex items-center justify-between h-10 px-4 sm:px-6 lg:px-8 text-xs text-base-content/40">
        <span>Summoner v0.1.3</span>
        <span>Local-first AI Platform</span>
      </div>
    </footer>
  </body>
</html>
